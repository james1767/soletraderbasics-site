---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  journeySupport,
  officialSources,
  rulesetMetadata,
} from "../../../lib/taxJourneyRules.mjs";

const title = "First Tax Return Timeline for Sole Traders | SoleTraderBasics";
const description =
  "Enter the date you started self-employment and see your first UK sole-trader tax journey, including tax-year end, Self Assessment deadlines and possible Payments on Account.";

const checkedMonthYear = new Intl.DateTimeFormat("en-GB", {
  month: "long",
  year: "numeric",
  timeZone: "Europe/London",
}).format(new Date(`${rulesetMetadata.lastReviewed}T12:00:00Z`));

const formatIsoDateLong = (isoDate) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${isoDate}T12:00:00Z`));

const primarySources = [
  officialSources.selfAssessmentDeadlines,
  officialSources.registerForSelfAssessment,
  officialSources.tradingAllowance,
  officialSources.paymentsOnAccount,
  officialSources.mtdEligibility,
  officialSources.selfEmployedRecords,
];
---

<BaseLayout title={title} description={description}>
  <article class="journey-page">
    <header class="journey-header">
      <p class="eyebrow">Sole trader tax roadmap</p>
      <h1>Your First Tax Journey as a Sole Trader</h1>
      <p class="intro">
        See what happens, when it happens — from the day you start working for
        yourself to your first tax payments.
      </p>
    </header>

    <section id="start-date" class="input-panel" aria-labelledby="journey-form-heading">
      <h2 id="journey-form-heading">Start with one date</h2>
      <form id="tax-journey-form" novalidate>
        <div class="field">
          <label for="start-date-input">When did you start working for yourself?</label>
          <input
            id="start-date-input"
            name="startDate"
            type="date"
            min={journeySupport.minimumStartDate}
            aria-describedby="start-date-help start-date-error"
            required
          />
          <p id="start-date-help" class="field-help">
            No signup. We don't need your earnings. This gives you a general
            timeline, not a tax calculation.
          </p>
          <p id="start-date-error" class="field-error" aria-live="polite"></p>
        </div>
        <button class="primary-button" type="submit">Show my journey</button>
      </form>
      <p class="privacy-note">
        Your start date is used in your browser to build this timeline and isn't
        saved by this tool.
      </p>
      <p class="quiet-note">
        Already been self-employed for a while? You can still enter your
        original start date to see how your first tax cycle was structured.
      </p>
      <p class="quiet-note">
        <a href="/resources/first-tax-journey-sole-trader-print/">
          Printable one-page guide
        </a>
        for advisers, workshops and handouts.
      </p>
    </section>

    <section
      id="journey-results"
      class="results"
      aria-labelledby="results-heading"
      tabindex="-1"
      hidden
    >
      <div id="result-announcement" class="sr-only" aria-live="polite"></div>

      <section class="summary-panel" aria-labelledby="results-heading">
        <h2 id="results-heading">Your first tax journey</h2>
        <p id="journey-summary"></p>
      </section>

      <section class="roadmap-breakout" aria-labelledby="roadmap-heading">
        <h3 id="roadmap-heading" class="roadmap-heading">Visual roadmap</h3>
        <ol
          id="journey-list"
          class="journey-list"
          aria-label="Generated tax journey"
        >
        </ol>
      </section>

      <section class="dates-panel" aria-labelledby="dates-heading">
        <h3 id="dates-heading">Your dates at a glance</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Event</th>
                <th scope="col">Date</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody id="dates-table-body"></tbody>
          </table>
        </div>
      </section>

      <section class="journey-explainer" aria-labelledby="journey-notes-heading">
        <h2 id="journey-notes-heading">What the roadmap means</h2>
        <div class="explainer-grid">
          <details>
            <summary>What should I do while I'm trading?</summary>
            <p>
              From the day you start, keep records of business income and
              expenses, track receipts and invoices, and consider setting money
              aside for tax.
            </p>
            <p>
              <a href="/guides/accounting-software/sole-trader-record-keeping-requirements/">
                Read the record keeping guide
              </a>
            </p>
          </details>

          <details>
            <summary>Do I need Self Assessment?</summary>
            <p>
              Starting as a sole trader does not automatically mean everyone
              needs to file a Self Assessment return.
            </p>
            <p>
              If gross trading income for the tax year is more than £1,000, a
              person normally needs to register for Self Assessment.
            </p>
            <p>
              If it is £1,000 or less, the trading allowance may mean they do
              not need to tell HMRC, although exceptions apply.
            </p>
            <p>
              <a href={officialSources.tradingAllowance.url}>
                Read HMRC guidance on the trading allowance
              </a>
            </p>
          </details>

          <details>
            <summary>Why isn't my first tax year 12 months?</summary>
            <p>
              UK tax years run from 6 April to 5 April. Your first tax period
              therefore ends on the next 5 April, even if you only started
              recently.
            </p>
          </details>

          <details>
            <summary>What if I've used Self Assessment before?</summary>
            <p>
              A person who has used Self Assessment before may not need to
              register from scratch. They should check the current HMRC process
              for their circumstances.
            </p>
            <p>
              <a href={officialSources.registerForSelfAssessment.url}>
                Check the HMRC registration process
              </a>
            </p>
          </details>
        </div>
      </section>

      <section class="context-grid" aria-label="Extra tax context">
        <details class="context-card">
          <summary>Why can the first January payment be bigger than expected?</summary>
          <p>
            If Payments on Account apply, your January payment can include both
            the tax due for the year just ended and an advance payment towards
            the next bill.
          </p>
          <div class="example-box" aria-label="Example only">
            <p><strong>Example only</strong></p>
            <p>Tax due for the year: £3,000</p>
            <p>Possible first payment on account: £1,500</p>
            <p>Potential January total: £4,500</p>
            <p>
              Possible second payment on account:
              <span data-field="poa-date-inline"></span>, £1,500 in this
              example
            </p>
          </div>
          <p>
            This is a simple example, not a calculation of what you will owe.
            Payments on Account usually do not apply if the relevant amount is
            below £1,000 or if more than 80% of the tax was collected outside
            Self Assessment. HMRC will show whether Payments on Account apply to
            you.
          </p>
          <p>
            <a href={officialSources.paymentsOnAccount.url}>
              Read HMRC guidance on Payments on Account
            </a>
          </p>
        </details>

        <section class="context-card" aria-labelledby="mtd-heading">
          <h2 id="mtd-heading">
            Making Tax Digital may change how you keep records and report
          </h2>
          <p>
            MTD for Income Tax applies according to qualifying income and other
            conditions. It does not currently change the basic Self Assessment
            payment dates shown in this roadmap.
          </p>
          <ul class="threshold-list">
            {
              officialSources.mtdEligibility.thresholdTimetable.map((row) => (
                <li>
                  <span>From {formatIsoDateLong(row.mtdStartDate)}</span>
                  {row.qualifyingIncomeThreshold}
                </li>
              ))
            }
          </ul>
          <p>
            <a href={officialSources.mtdEligibility.url}>
              Check if and when MTD applies to you — GOV.UK
            </a>
          </p>
        </section>
      </section>

      <section class="sources-panel" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Official sources and currentness</h2>
        <p>
          Checked against current HMRC guidance: <strong>{checkedMonthYear}</strong>
        </p>
        <p>
          SoleTraderBasics explains the journey. GOV.UK/HMRC remains the
          authority for the rules that apply to your circumstances.
        </p>
        <ul>
          {
            primarySources.map((source) => (
              <li>
                <a href={source.url}>{source.title}</a>
              </li>
            ))
          }
        </ul>
        <p class="quiet-note">
          For older start dates, this timeline is intended as an orientation to
          the tax-year structure. Rules applying at the time may have differed,
          so check historic records or HMRC guidance where necessary.
        </p>
      </section>
    </section>

    <section class="about-resource" aria-labelledby="why-built-heading">
      <h2 id="why-built-heading">Why we built this</h2>
      <p>
        New sole traders can face a surprisingly long gap between starting to
        earn and making their first Self Assessment payment.
      </p>
      <p>
        That can make it difficult to understand what happens when — and what
        should be done in the meantime.
      </p>
      <p>
        This roadmap is designed to make that sequence easier to see. It
        explains the journey and links to current official guidance where the
        rules depend on your circumstances.
      </p>

      <h2>What this roadmap doesn't do</h2>
      <p>
        It does not calculate your tax, determine whether you must file a
        return, or replace guidance from HMRC or advice from a qualified tax
        professional.
      </p>

      <aside class="visa-note" aria-labelledby="visa-heading">
        <h2 id="visa-heading">In the UK on a visa?</h2>
        <p>
          Some visa conditions restrict self-employment or freelance work. Check
          that your immigration conditions allow self-employment before relying
          on this roadmap.
        </p>
        <p><a href={officialSources.visaWorkConditions.url}>Check UK visa rules on GOV.UK</a></p>
      </aside>
    </section>

    <section class="related-links" aria-labelledby="related-heading">
      <h2 id="related-heading">Useful next guides</h2>
      <ul>
        <li>
          <a href="/guides/getting-started/register-sole-trader/">
            How to register as a sole trader
          </a>
        </li>
        <li>
          <a href="/guides/accounting-software/sole-trader-bookkeeping/">
            Sole trader bookkeeping UK
          </a>
        </li>
        <li>
          <a href="/guides/accounting-software/sole-trader-record-keeping-requirements/">
            Sole trader record keeping requirements
          </a>
        </li>
        <li>
          <a href="/guides/tax/sole-trader-tax-calendar-2026-27/">
            UK sole trader tax calendar 2026/27
          </a>
        </li>
      </ul>
    </section>

    <section class="faq-section" aria-labelledby="faq-heading">
      <h2 id="faq-heading">FAQ</h2>

      <h3>When will I file my first Self Assessment return?</h3>
      <p>
        If Self Assessment applies, the normal online filing deadline is 31
        January after the tax year has ended.
      </p>

      <h3>Why is my first tax year shorter than 12 months?</h3>
      <p>
        UK tax years run from 6 April to 5 April, so your first tax period ends
        on the next 5 April rather than 12 months after you began.
      </p>

      <h3>When will I pay tax for the first time?</h3>
      <p>
        If tax is due through Self Assessment, the normal payment deadline is
        the same 31 January date as the online return deadline.
      </p>

      <h3>Why can my first January payment be high?</h3>
      <p>
        It may include the tax due for the year just ended and, if Payments on
        Account apply, an advance payment towards the next bill.
      </p>

      <h3>Do I need Self Assessment if I earn £1,000 or less?</h3>
      <p>
        The trading allowance may mean you do not need to tell HMRC if gross
        trading income is £1,000 or less, but exceptions apply. Check HMRC
        guidance for your circumstances.
      </p>

      <h3>Does Making Tax Digital change when I pay my tax?</h3>
      <p>
        It does not currently change the basic Self Assessment payment dates
        shown in this roadmap.
      </p>
    </section>
  </article>
</BaseLayout>

<script>
  import {
    TaxJourneyValidationError,
    buildFirstTaxJourney,
  } from "../../../lib/taxJourney.mjs";

  const form = document.querySelector("#tax-journey-form");
  const input = document.querySelector("#start-date-input");
  const error = document.querySelector("#start-date-error");
  const results = document.querySelector("#journey-results");
  const announcement = document.querySelector("#result-announcement");
  const summary = document.querySelector("#journey-summary");
  const tableBody = document.querySelector("#dates-table-body");
  const journeyList = document.querySelector("#journey-list");
  const poaDateInline = document.querySelector('[data-field="poa-date-inline"]');

  const formatDate = (isoDate) =>
    new Intl.DateTimeFormat("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    }).format(new Date(`${isoDate}T12:00:00Z`));

  const clearError = () => {
    error.textContent = "";
    input.removeAttribute("aria-invalid");
  };

  const showError = (message) => {
    error.textContent = message;
    input.setAttribute("aria-invalid", "true");
    results.hidden = true;
    input.focus();
  };

  const getErrorMessage = (error) => {
    if (!(error instanceof TaxJourneyValidationError)) {
      return "Something went wrong. Check the date and try again.";
    }

    if (error.code === "future-date") {
      return "Enter a start date that is today or earlier.";
    }

    if (error.code === "outside-supported-range") {
      return "This tool supports start dates from 6 April 2020 onwards.";
    }

    if (input.value === "") {
      return "Enter the date you started working for yourself.";
    }

    return "Enter a real date using the format YYYY-MM-DD.";
  };

  const getShortFirstYearCopy = (days) => {
    if (days <= 45) {
      return "An unusually short first tax year.";
    }

    if (days <= 120) {
      return "Only part of a tax year.";
    }

    if (days <= 275) {
      return "Runs to 5 April, not for 12 months.";
    }

    return "Most or almost all of the tax year.";
  };

  const getTodayIso = () => {
    const parts = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/London",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).formatToParts(new Date());
    const partValue = (type) => parts.find((part) => part.type === type).value;

    return `${partValue("year")}-${partValue("month")}-${partValue("day")}`;
  };

  const getCurrentPosition = (journey) => {
    const today = getTodayIso();
    const finalDate = journey.possibleSecondPaymentOnAccountDate;

    if (today > finalDate) {
      return {
        afterFinal: true,
        segmentId: "after-final",
        text: "You've passed the main dates shown in this first-tax journey.",
      };
    }

    if (today <= journey.startDate) {
      return { afterFinal: false, segmentId: "start", text: "YOU ARE HERE" };
    }

    if (today <= journey.taxYearEnd) {
      return { afterFinal: false, segmentId: "trading", text: "YOU ARE HERE" };
    }

    if (today <= journey.potentialNotificationDate) {
      return { afterFinal: false, segmentId: "hmrc", text: "YOU ARE HERE" };
    }

    if (today <= journey.onlineReturnDeadline) {
      return { afterFinal: false, segmentId: "january", text: "YOU ARE HERE" };
    }

    return { afterFinal: false, segmentId: "poa", text: "YOU ARE HERE" };
  };

  const renderTable = (journey) => {
    const rows = [
      ["You started", journey.startDate, "Your date"],
      ["First tax year ends", journey.taxYearEnd, "Your date"],
      ["Tell/check HMRC", journey.potentialNotificationDate, "Check whether this applies"],
      ["Online return", journey.onlineReturnDeadline, "If Self Assessment applies"],
      ["Tax payment", journey.paymentDeadline, "Depends on your bill"],
      ["Second payment on account", journey.possibleSecondPaymentOnAccountDate, "May apply"],
    ];

    tableBody.replaceChildren(
      ...rows.map(([event, date, status]) => {
        const row = document.createElement("tr");
        row.innerHTML = `<td>${event}</td><td>${formatDate(date)}</td><td>${status}</td>`;
        return row;
      }),
    );
  };

  const createCurrentMarker = (text) => {
    const marker = document.createElement("p");
    marker.className = "you-are-here";
    marker.textContent = text;
    return marker;
  };

  const createRoadmapDate = (date) => {
    const dateEl = document.createElement("p");
    dateEl.className = "phase-date";

    if (date.includes(" to ")) {
      const [start, end] = date.split(" to ");
      dateEl.classList.add("phase-date-range");
      dateEl.innerHTML = `<span>${start}</span><span aria-hidden="true">→</span><span>${end}</span>`;
      return dateEl;
    }

    const lastSpace = date.lastIndexOf(" ");
    dateEl.innerHTML = `<span class="date-main">${date.slice(0, lastSpace)}</span><span class="date-year">${date.slice(lastSpace + 1)}</span>`;
    return dateEl;
  };

  const createPhase = ({
    id,
    label,
    date,
    heading,
    status,
    statusClass,
    copy,
  }) => {
    const item = document.createElement("li");
    item.className = `phase ${statusClass}`;
    item.dataset.segment = id;

    const labelEl = document.createElement("p");
    labelEl.className = "phase-label";
    labelEl.textContent = label;

    const dateEl = createRoadmapDate(date);

    const headingEl = document.createElement("h3");
    headingEl.textContent = heading;

    const copyEl = document.createElement("p");
    copyEl.textContent = copy;

    item.append(labelEl);

    if (status) {
      const statusEl = document.createElement("p");
      statusEl.className = "state-label";
      statusEl.textContent = status;
      item.append(statusEl);
    }

    item.append(dateEl, headingEl, copyEl);
    return item;
  };

  const renderJourney = (journey) => {
    const currentPosition = getCurrentPosition(journey);

    const startPhase = createPhase({
      id: "start",
      label: "YOU START",
      date: formatDate(journey.startDate),
      status: "YOUR DATE",
      statusClass: "known",
      heading: "You start working for yourself",
      copy: "Begin keeping business records.",
    });

    const tradingPhase = createPhase({
      id: "trading",
      label: "YOU'RE TRADING",
      date: `${formatDate(journey.startDate)} to ${formatDate(journey.taxYearEnd)}`,
      status: "",
      statusClass: "span",
      heading: "Trading period",
      copy: "The gap before January can be long.",
    });
    const behaviours = document.createElement("ul");
    behaviours.className = "behaviour-list";
    ["KEEP RECORDS", "TRACK INCOME & EXPENSES", "PUT MONEY ASIDE"].forEach((behaviour) => {
      const item = document.createElement("li");
      item.textContent = behaviour;
      behaviours.append(item);
    });
    tradingPhase.append(behaviours);

    const taxYearEndPhase = createPhase({
      id: "tax-year-end",
      label: "THE TAX YEAR ENDS",
      date: formatDate(journey.taxYearEnd),
      status: "YOUR DATE",
      statusClass: "known",
      heading: "Your first tax year ends here",
      copy: getShortFirstYearCopy(journey.daysFromStartThroughTaxYearEnd),
    });

    const reportPhase = createPhase({
      id: "january",
      label: "FILE & PAY",
      date: formatDate(journey.onlineReturnDeadline),
      status: "CONDITIONAL",
      statusClass: "conditional",
      heading: "Online return and payment point",
      copy: "If Self Assessment applies.",
    });

    const notification = createPhase({
      id: "hmrc",
      label: "CHECK HMRC",
      date: formatDate(journey.potentialNotificationDate),
      status: "",
      statusClass: "conditional",
      heading: "Make sure HMRC knows if you need to file",
      copy: "Check if this applies.",
    });

    const secondPoa = createPhase({
      id: "poa",
      label: "MAY APPLY",
      date: formatDate(journey.possibleSecondPaymentOnAccountDate),
      status: "",
      statusClass: "may-apply",
      heading: "Second payment on account",
      copy: "If HMRC has calculated one for you.",
    });

    const phases = [
      startPhase,
      tradingPhase,
      taxYearEndPhase,
      notification,
      reportPhase,
      secondPoa,
    ];

    if (currentPosition.afterFinal) {
      const marker = document.createElement("li");
      marker.className = "past-journey";
      marker.textContent = currentPosition.text;
      phases.unshift(marker);
    } else {
      const currentPhase = phases.find(
        (phase) => phase.dataset.segment === currentPosition.segmentId,
      );
      currentPhase?.classList.add("current");
      currentPhase?.prepend(createCurrentMarker(currentPosition.text));
    }

    journeyList.replaceChildren(...phases);
  };

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    clearError();

    try {
      const journey = buildFirstTaxJourney(input.value);
      summary.textContent = `You started on ${formatDate(journey.startDate)}. Your first tax year ends on ${formatDate(journey.taxYearEnd)}.`;
      poaDateInline.textContent = formatDate(journey.possibleSecondPaymentOnAccountDate);
      renderTable(journey);
      renderJourney(journey);
      results.hidden = false;
      announcement.textContent = "Your first tax journey has been generated.";
      results.focus({ preventScroll: false });
    } catch (caughtError) {
      showError(getErrorMessage(caughtError));
    }
  });
</script>

<style>
  :global(main) {
    max-width: 1120px;
    overflow: visible;
  }

  .journey-page {
    max-width: 100%;
  }

  .journey-header,
  .input-panel,
  .summary-panel,
  .dates-panel,
  .journey-explainer,
  .context-grid,
  .sources-panel,
  .about-resource,
  .related-links,
  .faq-section {
    max-width: 820px;
  }

  .eyebrow,
  .phase-label,
  .state-label,
  .mini-label {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    margin: 0 0 0.4rem;
    text-transform: uppercase;
  }

  .intro {
    color: var(--muted);
    font-size: 1.12rem;
  }

  .input-panel,
  .summary-panel,
  .dates-panel,
  .journey-explainer,
  .sources-panel,
  .about-resource,
  .related-links,
  .faq-section,
  .context-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #ffffff;
    margin-left: auto;
    margin-right: auto;
    margin-top: 1.5rem;
    padding: 1.25rem;
  }

  .field {
    max-width: 34rem;
  }

  label {
    display: block;
    font-weight: 800;
    margin-bottom: 0.45rem;
  }

  input[type="date"] {
    width: 100%;
    max-width: 20rem;
    min-height: 46px;
    border: 2px solid #94a3b8;
    border-radius: 8px;
    color: var(--text);
    font: inherit;
    padding: 0.55rem 0.7rem;
  }

  input[type="date"]:focus,
  button:focus-visible,
  a:focus-visible,
  summary:focus-visible,
  .results:focus {
    outline: 3px solid #facc15;
    outline-offset: 3px;
  }

  input[aria-invalid="true"] {
    border-color: #b91c1c;
  }

  .field-help,
  .quiet-note,
  .privacy-note {
    color: var(--muted);
  }

  .field-error {
    color: #991b1b;
    font-weight: 700;
    margin: 0.55rem 0 0;
  }

  .primary-button {
    align-items: center;
    background: var(--link);
    border: 1px solid var(--link);
    border-radius: 8px;
    color: #ffffff;
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-weight: 800;
    justify-content: center;
    margin-top: 1rem;
    min-height: 46px;
    padding: 0.72rem 1.1rem;
  }

  .primary-button:hover {
    background: var(--link-hover);
  }

  .results {
    margin-top: 2rem;
  }

  .summary-panel {
    background: #ffffff;
    padding: 1.4rem;
  }

  .summary-panel > p {
    max-width: 820px;
  }

  .roadmap-heading {
    border-top: 0;
    margin: 0 0 1.25rem;
    padding-top: 0;
  }

  .roadmap-breakout {
    background: #f8fafc;
    border: 1px solid var(--border);
